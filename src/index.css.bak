@import url('https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;900&display=swap');

:root {
  --primary-color: #FF6464;
  --secondary-color: #00A8CC;
  --dark-color: #21243D;
  --light-color: #8695A4;
  --bg-light: #EDF7FA;
  --bg-white: #FFFFFF;
}

html[data-theme='dark'] {
  --primary-color: #64d2ff;
  --secondary-color: #a855f7;
  --dark-color: #f8fafc;
  --light-color: #94a3b8;
  --bg-light: #0f172a;
  --bg-white: #111826;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.language-picker select,
.theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(15, 23, 42, 0.08);
  border-radius: 999px;
  background: #f8fafc;
  color: #0f172a;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: transform 0.2s ease, background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
}

.language-picker select {
  min-width: 150px;
  padding: 10px 16px;
  background: transparent;
  appearance: none;
}

.theme-toggle {
  width: 48px;
  height: 48px;
  padding: 0;
  border-radius: 50%;
  background: #fff;
}

.theme-toggle .theme-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  font-size: 18px;
}

.theme-toggle:hover,
.language-picker select:hover {
  transform: translateY(-1px);
  border-color: rgba(244, 63, 94, 0.9);
}

.language-picker select:focus,
.theme-toggle:focus {
  outline: none;
  border-color: rgba(244, 63, 94, 0.9);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Heebo', sans-serif;
  color: var(--dark-color);
  background-color: var(--bg-white);
  line-height: 1.6;
  overflow-x: hidden;
}

a {
  text-decoration: none;
  color: inherit;
  transition: color 0.3s ease;
}

ul {
  list-style: none;
}

.container {
  max-width: 1024px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Header */
header {
  padding: 18px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(226, 232, 240, 0.9);
  transition: background 0.3s ease, border-color 0.3s ease;
}

.nav-links {
  display: flex;
  gap: 32px;
  flex-wrap: wrap;
  flex: 1;
  justify-content: center;
}

.nav-links a {
  color: rgba(15, 23, 42, 0.94);
  font-weight: 600;
  font-size: 17px;
  padding: 10px 0;
  transition: color 0.25s ease, border-color 0.25s ease;
}

.nav-links a:hover,
.nav-links a.active {
  color: #f43f5e;
}

.nav-links a.active {
  position: relative;
}

.nav-links a.active::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -2px;
  width: calc(100% - 4px);
  height: 2px;
  background: #f43f5e;
  border-radius: 999px;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 14px;
  justify-content: flex-end;
}

html[data-theme='dark'] header {
  background: rgba(15, 23, 42, 0.96);
  border-color: rgba(71, 85, 105, 0.2);
}

html[data-theme='dark'] .nav-links a {
  color: rgba(241, 245, 249, 0.88);
}

html[data-theme='dark'] .nav-links a:hover,
html[data-theme='dark'] .nav-links a.active {
  color: #8edbff;
}

html[data-theme='dark'] .theme-toggle {
  background: #0f172a;
  color: #f8fafc;
  border-color: rgba(148, 163, 184, 0.2);
}

html[data-theme='dark'] .theme-toggle .theme-icon {
  background: transparent;
  color: #f8fafc;
}

html[data-theme='dark'] .language-picker select {
  color: #f8fafc;
  background: rgba(30, 41, 59, 0.16);
  border-color: rgba(148, 163, 184, 0.25);
}

.menu-btn {
  display: none;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 12px;
  padding: 12px;
  cursor: pointer;
  color: #fff;
}

.menu-btn:hover {
  background: rgba(255, 255, 255, 0.12);
}

.nav-links a {
  font-weight: 500;
  font-size: 20px;
}

.nav-links a:hover,
.nav-links a.active {
  color: var(--primary-color);
}

/* Mobile Menu */
.menu-btn {
  display: none;
  background: none;
  border: none;
  font-size: 30px;
  cursor: pointer;
}

/* Hero Section */
.hero {
  padding: 100px 0 70px;
}

.hero .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 50px;
}

.hero-content {
  flex: 1;
}

.hero h1 {
  font-size: 44px;
  font-weight: 700;
  margin-bottom: 20px;
  line-height: 60px;
}

.hero p {
  font-size: 16px;
  margin-bottom: 30px;
  max-width: 500px;
}

.btn {
  display: inline-block;
  background-color: var(--primary-color);
  color: white;
  padding: 15px 30px;
  border-radius: 2px;
  font-size: 20px;
  font-weight: 500;
  border: none;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.btn:hover {
  background-color: #e55555;
}

.hero-image {
  width: 243px;
  height: 243px;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: -10px 10px 0 #EDF7FA;
  flex-shrink: 0;
  background-color: #e0e0e0;
}

.hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
